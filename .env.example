# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# OpenRouter (https://openrouter.ai/settings/keys) — STT와 요약 모두 사용
OPENROUTER_API_KEY=
# 음성 인식 모델 (선택)
STT_MODEL=openai/whisper-large-v3
# 요약 모델, 쉼표로 구분해 우선순위대로 (선택). 앞 모델이 실패하면 다음 모델로 넘어감
SUMMARY_MODELS=anthropic/claude-sonnet-5.5,anthropic/claude-haiku-5.5

# Notion (통합 토큰: https://www.notion.so/profile/integrations)
NOTION_TOKEN=
# 회의 항목을 추가할 📍 Moamap Planner의 데이터 소스 ID. Planner에 통합을 "연결"해 두어야 함
# (속성: 이름(제목), 날짜, 태그(회의/비대면 포함), 참석자)
NOTION_PLANNER_DATA_SOURCE_ID=
# 세컨드 브레인이 읽을 팀 최상위 페이지 ID (하위 페이지·DB를 모두 읽음)
NOTION_ROOT_PAGE_ID=

# GitHub (세컨드 브레인용 이슈 읽기). Fine-grained 토큰: Moa-Map 조직 저장소 Issues 읽기 권한
GITHUB_TOKEN=
GITHUB_ORG=Moa-Map

# 세컨드 브레인 (선택)
# 답변 모델
BRAIN_MODEL=anthropic/claude-haiku-5.5
# 제목에 이 단어가 들어간 노션 페이지는 하위까지 통째로 제외 (쉼표 구분, 민감 정보)
BRAIN_NOTION_EXCLUDE=개인 연락처,계정,회계,Certificate,.env,API 키,API key,secret,토큰,token,비밀번호,password

# 위키 (선택). 위키 폴더, 바뀐 원본을 위키에 반영하는 주기(시간),
# 주간 점검 결과를 올릴 디스코드 채널 ID(비우면 점검 안 함)
WIKI_DIR=./wiki
WIKI_UPDATE_HOURS=24
WIKI_REPORT_CHANNEL_ID=

# 녹음 저장 위치 (선택)
RECORDINGS_DIR=./recordings
